<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock TriggerFlow Pro"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get the most out of your automation."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Features List -->
        <LinearLayout
            android:id="@+id/featuresContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Advanced Activity Logs"
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Quick Settings Tile"
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Unlimited Trusted Networks"
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
                
             <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Battery Optimization Auto-Fix"
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>

        <!-- Plans Container -->
        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/featuresContainer"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btnLifetime"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Lifetime - $49.99 (Best Value)"
                android:backgroundTint="#FFD700"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnYearly"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Yearly - $19.99 (Save 20%)"
                android:backgroundTint="@color/purple_500"
                android:textColor="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnMonthly"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Monthly - $2.99"
                android:backgroundTint="#333333"
                android:textColor="@android:color/white"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnRedeem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Have a promo code? Redeem here."
            android:textColor="@color/teal_200"
            android:textSize="14sp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/plansContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/btnRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore Purchases"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnRedeem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
